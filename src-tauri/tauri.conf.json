{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proton Drive for Linux",
  "version": "0.1.0",
  "identifier": "io.github.zhafrisbs.protondrive-linux",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../WebClients/applications/drive/dist"
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "zhafrisbs and contributors; upstream DonnieDice",
    "category": "Utility",
    "shortDescription": "Unofficial Proton Drive desktop client",
    "longDescription": "Unofficial web-based Proton Drive client for Linux with two-way folder sync.",
    "license": "AGPL-3.0-or-later",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "app": {
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "withGlobalTauri": true,
    "windows": []
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
