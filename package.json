{
  "name": "proton-drive-linux",
  "version": "0.1.0",
  "description": "Proton Drive for Linux (Unofficial) — web-based edition",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhafribs/Proton-Drive-Linux.git"
  },
  "keywords": [
    "proton",
    "drive",
    "desktop",
    "tauri",
    "sync"
  ],
  "author": "zhafrisbs and contributors",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "prebuild": "node -e \"const v=process.versions.node.split('.').map(Number); if(v[0]<20){console.error('Node.js 20+ required, got '+process.version); process.exit(1)}\"",
    "build": "npm run build:appimage",
    "build:web": "./scripts/build-webclients.sh",
    "build:appimage": "npm run build:web && tauri build --bundles appimage",
    "test:planner": "vitest run tests/js",
    "test": "npm run test:planner"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "vitest": "^5.0.5"
  }
}
